class Solution:
    def countSubarrays(self, nums: List[int], target: int) -> int:
        n = len(nums)

        arr = [1 if x == target else -1 for x in nums]

        ans = 0

        for i in range(n):
            curr_sum = 0
            for j in range(i, n):
                curr_sum += arr[j]
                if curr_sum > 0:
                    ans += 1

        return ans
