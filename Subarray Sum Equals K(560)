class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        d={0:1}
        count=0
        sum=0
        for i in nums:
            sum+=i
            rem=sum-k
            if(rem in d):
                count+=d[rem]
            if(sum in d):
                d[sum]=d[sum]+1
            else:
                d[sum]=1
        return count
