from functools import lru_cache

class Solution:
    def totalWaviness(self, num1: int, num2: int) -> int:

        def solve(x):
            if x <= 0:
                return 0

            s = str(x)

            @lru_cache(None)
            def dfs(pos, last1, last2, tight):
                if pos == len(s):
                    return (1, 0)  # (count, waviness_sum)

                limit = int(s[pos]) if tight else 9

                total_count = 0
                total_sum = 0

                for d in range(limit + 1):
                    ntight = tight and (d == limit)

                    if last1 == 10:
                        # No digit chosen yet
                        if d == 0:
                            cnt, sm = dfs(pos + 1, 10, 10, ntight)
                        else:
                            cnt, sm = dfs(pos + 1, d, 10, ntight)

                    elif last2 == 10:
                        # Exactly one digit chosen
                        cnt, sm = dfs(pos + 1, d, last1, ntight)

                    else:
                        add = int(
                            (last1 > last2 and last1 > d) or
                            (last1 < last2 and last1 < d)
                        )

                        cnt, sm = dfs(pos + 1, d, last1, ntight)
                        sm += add * cnt

                    total_count += cnt
                    total_sum += sm

                return (total_count, total_sum)

            return dfs(0, 10, 10, True)[1]

        return solve(num2) - solve(num1 - 1)
