class Solution:
    def countVowels(self, word: str) -> int:
        '''substrings = []
        vowels = "aeiouAEIOU"
        count = 0
        for i in range(len(word)) :
            for j in range(i + 1, len(word) + 1) :
                sub = word[i:j]
                for ch in sub :
                    if ch in vowels :
                        count += 1
        return count'''

        ans = 0
        n = len(word)
        for i, ch in enumerate(word) :
            if ch in "aeiou" :
                ans += (i + 1) * (n - i)
        return ans
