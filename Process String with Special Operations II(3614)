class Solution:
    def processStr(self, s: str, k: int) -> str:
        length = 0

        # Compute final length
        for ch in s:
            if ch.islower():
                length += 1
            elif ch == '*':
                length = max(0, length - 1)
            elif ch == '#':
                length *= 2
            # '%' does not change length

        if k >= length:
            return '.'

        # Work backwards
        for ch in reversed(s):
            if ch == '*':
                length += 1

            elif ch == '#':
                length //= 2
                k %= length

            elif ch == '%':
                k = length - 1 - k

            else:  # lowercase letter
                length -= 1
                if k == length:
                    return ch

        return '.'
